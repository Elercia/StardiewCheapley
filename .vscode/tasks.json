{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "windows" : {
                "command": "${workspaceFolder}/scripts/compile.bat",
            },
            "linux" :{
                "command": "${workspaceFolder}/scripts/compile.sh",
            },
            "osx":{
                "command": "${workspaceFolder}/scripts/compile.sh",
            },
            "options": {
                "cwd": "${workspaceFolder}/scripts/"
            },
            "problemMatcher": ["$rgbdserror", "$rgbdslinkerror"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}